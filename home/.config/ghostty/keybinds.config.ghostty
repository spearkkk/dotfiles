keybind = global:super+backslash=toggle_quick_terminal
keybind = super+ctrl+arrow_up=resize_split:up,25
keybind = super+ctrl+arrow_down=resize_split:down,25
keybind = super+ctrl+arrow_left=resize_split:left,25
keybind = super+ctrl+arrow_right=resize_split:right,25

# Korean 2-set input source variants for tmux Meta pane navigation/zoom.
keybind = alt+ㅗ=esc:h
keybind = alt+ㅓ=esc:j
keybind = alt+ㅏ=esc:k
keybind = alt+ㅣ=esc:l
keybind = alt+ㅋ=esc:z
