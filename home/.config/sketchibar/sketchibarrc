#!/bin/bash
# Detail collectors are independent of the main bar.
# Main bar must remain above this backplate (topmost=on, margin=0).
set -eu

args=(
  --bar display=all position=top height=80 margin=0 y_offset=0
        corner_radius=0 border_width=3 blur_radius=0
        color=0xff0a1f2e border_color=0xff0a1f2e
        padding_left=4 padding_right=4 shadow=off sticky=on
        topmost=window hidden=on
  --default background.drawing=off icon.drawing=on
            icon.font="tabler-icons:Regular:16" icon.padding_left=4 icon.padding_right=5
            label.font="SF Pro:Regular:12" label.color=0xffc6d8e4
            label.padding_left=0 label.padding_right=5
            padding_left=3 padding_right=3 update_freq=0 y_offset=-20
)

item() {
  args+=(--add item "$1" right --set "$1" "icon=$2" "label=$3" "icon.color=$4")
}

group() {
  local name=$1
  shift
  args+=(--add bracket "$name" "$@" --set "$name"
         background.drawing=on background.color=0xff142c3e
         background.height=28 background.corner_radius=4 background.border_width=0)
}

gap() {
  args+=(--add item "$1" right --set "$1" width=14
         icon.drawing=off label.drawing=off background.drawing=off)
}

# Right-side items flow right-to-left. Tabler glyphs match the installed font.
item sketchibar.weather.wind '' '—' 0xff8ba7bb
item sketchibar.weather.precip '' '—' 0xff7896cc
item sketchibar.weather.high '' '—' 0xffc8945a
item sketchibar.weather.low '' '—' 0xff7896cc
item sketchibar.weather.current '' '—' 0xffc8ae6a
group sketchibar.weather sketchibar.weather.current sketchibar.weather.low \
      sketchibar.weather.high sketchibar.weather.precip sketchibar.weather.wind

gap sketchibar.gap.weather
item sketchibar.battery.trackpad '' '' 0xff8ba7bb
args+=(--set sketchibar.battery.trackpad drawing=off)
item sketchibar.battery.keyboard '' '' 0xff8ba7bb
args+=(--set sketchibar.battery.keyboard drawing=off)
item sketchibar.battery.time '' '—' 0xff8ba7bb
args+=(--set sketchibar.battery.time drawing=off)
item sketchibar.battery.level '９' '—' 0xff68be92
args+=(--set sketchibar.battery.level icon.font.size=18)
group sketchibar.battery sketchibar.battery.level sketchibar.battery.time \
      sketchibar.battery.keyboard sketchibar.battery.trackpad

gap sketchibar.gap.cafe
item sketchibar.cafe.remaining '' '--' 0xff4a6e86
group sketchibar.cafe sketchibar.cafe.remaining
args+=(--set sketchibar.cafe.remaining drawing=off --set sketchibar.cafe drawing=off
       --set sketchibar.gap.cafe drawing=off)

# Display only: the main bar owns the timer, persistence and notifications.
gap sketchibar.gap.pomodoro
args+=(
  --add item sketchibar.pomodoro right
  --set sketchibar.pomodoro drawing=off label="" icon=""
)
group sketchibar.pomodoro.group sketchibar.pomodoro

# Quote the installed path for SketchyBar's shell-based script runner.
printf -v helper '%q' "$HOME/.local/libexec/sketchibar-update"
printf -v main_binary '%q' "$(command -v sketchybar)"
hover_script='case "$SENDER" in
  mouse.entered.global) action=enter ;;
  mouse.exited.global) action=exit ;;
  *) exit 0 ;;
esac
'"$main_binary"' --trigger sketchibar_hover "ACTION=$action"'
args+=(
  --add item sketchibar.hover left
  --set sketchibar.hover drawing=off updates=on "script=$hover_script"
  --subscribe sketchibar.hover mouse.entered.global mouse.exited.global
  --add event cafe_changed
  --add item sketchibar.cafe.worker left
  --set sketchibar.cafe.worker drawing=off updates=on update_freq=60 "script=$helper cafe"
  --subscribe sketchibar.cafe.worker cafe_changed system_woke
  --add item sketchibar.system left
  --set sketchibar.system drawing=off update_freq=60 "script=$helper system"
  --subscribe sketchibar.system power_source_change system_woke
  --set sketchibar.weather.current update_freq=1800 "script=$helper weather"
  --subscribe sketchibar.weather.current system_woke wifi_change
)

# Optional, local-only overlays share the same item/group/gap helpers. Keep all
# profile-specific names, collectors and data outside the common configuration.
profile="$HOME/.config/sketchibar/profile.sh"
if [[ -e "$profile" || -L "$profile" ]]; then
  if [[ ! -f "$profile" || ! -r "$profile" ]]; then
    printf 'sketchibar: local profile is not a readable file\n' >&2
    exit 1
  fi
  source "$profile"
fi
args+=(--update)

"$HOME/.local/bin/sketchibar" "${args[@]}"
