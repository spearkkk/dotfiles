#!/bin/sh

set -eu

operation=${1:-}
pane=${2:-}
empty='{"schema":1,"revision":0,"contexts":[]}'
jq_validation='
  def safe_identifier:
    if type != "string" then false
    else length >= 1 and length <= 128 and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")
    end;
  def valid_context:
    if type != "object" then false
    else
      (keys | sort) == ["alert","environment","id","instance","slot","state"] and
      (.instance | safe_identifier) and
      (.id | safe_identifier) and
      (.slot | safe_identifier) and
      (.environment | safe_identifier) and
      (.alert | type == "boolean") and
      (.state == "connecting" or .state == "active" or .state == "offline" or .state == "error")
    end;
  def valid_document:
    if type != "object" then false
    else
      (keys | sort) == ["contexts","revision","schema"] and
      .schema == 1 and
      (.revision | type == "number" and . >= 0 and . == floor) and
      (.contexts | type == "array") and
      all(.contexts[]; valid_context) and
      ([.contexts[].slot] | length) == ([.contexts[].slot] | unique | length) and
      ([.contexts[].instance] | length) == ([.contexts[].instance] | unique | length)
    end;
'

usage() {
  printf '%s\n' 'usage: tmux-pane-context list PANE | inject PANE DESCRIPTOR_JSON [EXPECTED_INSTANCE] | eject PANE SLOT [INSTANCE] | state PANE INSTANCE STATE | clear PANE' >&2
  exit 64
}

case $operation in
  list|clear) [ "$#" -eq 2 ] || usage ;;
  inject) [ "$#" -eq 3 ] || [ "$#" -eq 4 ] || usage ;;
  eject) [ "$#" -eq 3 ] || [ "$#" -eq 4 ] || usage ;;
  state) [ "$#" -eq 4 ] || usage ;;
  *) usage ;;
esac

command -v jq >/dev/null 2>&1 || {
  printf '%s\n' 'tmux-pane-context: jq is required' >&2
  exit 69
}

lock_mutation() {
  command -v lockf >/dev/null 2>&1 || {
    printf '%s\n' 'tmux-pane-context: lockf is required' >&2
    exit 69
  }

  target=$(tmux display-message -p -t "$pane" '#{socket_path}|#{pane_id}' 2>/dev/null) || {
    printf 'tmux-pane-context: pane not found: %s\n' "$pane" >&2
    exit 65
  }
  socket_path=${target%|*}
  resolved_pane=${target##*|}
  socket_key=$(printf '%s' "$socket_path" | cksum)
  socket_key=${socket_key%% *}
  lock_file="${TMPDIR:-/tmp}/tmux-pane-context-${socket_key}-${resolved_pane#%}.lock"

  [ "${TMUX_PANE_CONTEXT_LOCKED:-}" = "$lock_file" ] && return

  if TMUX_PANE_CONTEXT_LOCKED="$lock_file" \
      lockf -k -t 5 "$lock_file" "$0" "$@"; then
    exit 0
  else
    status=$?
    if [ "$status" -eq 75 ]; then
      printf 'tmux-pane-context: timed out waiting for pane lock: %s\n' "$resolved_pane" >&2
    fi
    exit "$status"
  fi
}

read_contexts() {
  value=$(tmux show-options -pqv -t "$pane" @contexts 2>/dev/null || :)
  [ -n "$value" ] || value=$empty
  printf '%s' "$value" | jq -ce "$jq_validation select(valid_document)" 2>/dev/null || {
    printf 'tmux-pane-context: invalid @contexts on %s\n' "$pane" >&2
    exit 65
  }
}

refresh_clients() {
  tmux list-clients -F '#{client_name}' 2>/dev/null |
    while IFS= read -r client; do
      [ -n "$client" ] || continue
      tmux refresh-client -S -t "$client" >/dev/null 2>&1 || :
    done
}

set_projection() {
  projection_display=$(printf '%s' "$1" | jq -r '
    [.contexts[] | .id +
      (if .state == "connecting" then "…"
       elif .state == "offline" then "○"
       elif .state == "error" then "!"
       else "" end)] | join(" | ")
  ')
  projection_alert=$(printf '%s' "$1" | jq -r '
    any(.contexts[]; .alert == true and (.state == "connecting" or .state == "active"))
    | if . then "1" else "0" end
  ')
}

projection_matches() {
  set_projection "$1"
  stored_display=$(tmux show-options -pqv -t "$pane" @contexts_display 2>/dev/null || :)
  stored_alert=$(tmux show-options -pqv -t "$pane" @contexts_alert 2>/dev/null || :)
  [ "$stored_display" = "$projection_display" ] &&
    [ "$stored_alert" = "$projection_alert" ]
}

write_projection() {
  set_projection "$1"
  stored_display=$(tmux show-options -pqv -t "$pane" @contexts_display 2>/dev/null || :)
  stored_alert=$(tmux show-options -pqv -t "$pane" @contexts_alert 2>/dev/null || :)

  [ "$stored_display" = "$projection_display" ] ||
    tmux set-option -p -t "$pane" @contexts_display "$projection_display"
  [ "$stored_alert" = "$projection_alert" ] ||
    tmux set-option -p -t "$pane" @contexts_alert "$projection_alert"
}

write_contexts() {
  next=$1
  next=$(printf '%s' "$next" | jq -ce "$jq_validation select(valid_document)" 2>/dev/null) || {
    printf 'tmux-pane-context: refusing invalid @contexts for %s\n' "$pane" >&2
    return 65
  }
  bytes=$(printf '%s' "$next" | wc -c | tr -d ' ')
  if [ "$bytes" -gt 4096 ]; then
    printf 'tmux-pane-context: @contexts exceeds 4096 bytes (%s)\n' "$bytes" >&2
    return 65
  fi

  tmux set-option -p -t "$pane" @contexts "$next"
  write_projection "$next"
  refresh_clients
}

if [ "$operation" = list ]; then
  current=$(read_contexts)
  if ! projection_matches "$current"; then
    lock_mutation "$@"
    current=$(read_contexts)
    if ! projection_matches "$current"; then
      write_projection "$current"
      refresh_clients
    fi
  fi
  printf '%s\n' "$current"
  exit 0
fi

lock_mutation "$@"
current=$(read_contexts)
if ! projection_matches "$current"; then
  write_projection "$current"
  refresh_clients
fi
next=$current

case $operation in
  inject)
    descriptor=$3
    descriptor=$(printf '%s' "$descriptor" | jq -ce "$jq_validation select(valid_context)" 2>/dev/null) || {
      printf '%s\n' 'tmux-pane-context: invalid descriptor' >&2
      exit 65
    }
    # Optional compare-and-set under the pane lock; empty means unoccupied.
    if [ "$#" -eq 4 ]; then
      occupant=$(printf '%s' "$current" | jq -r --argjson descriptor "$descriptor" '
        first(.contexts[] | select(.slot == $descriptor.slot) | .instance) // ""
      ')
      if [ "$occupant" != "$4" ]; then
        printf '%s\n' 'tmux-pane-context: slot changed; refusing replacement' >&2
        exit 65
      fi
    fi
    next=$(printf '%s' "$current" | jq -c --argjson descriptor "$descriptor" '
      .revision += 1 |
      .contexts = ([.contexts[] | select(.slot != $descriptor.slot)] + [$descriptor])
    ')
    ;;
  eject)
    slot=$3
    instance=${4:-}
    matches=$(printf '%s' "$current" | jq -r --arg slot "$slot" --arg instance "$instance" '
      any(.contexts[]; .slot == $slot and ($instance == "" or .instance == $instance))
    ')
    [ "$matches" = true ] || exit 0
    next=$(printf '%s' "$current" | jq -c --arg slot "$slot" --arg instance "$instance" '
      .revision += 1 |
      .contexts = [.contexts[] | select(.slot != $slot or ($instance != "" and .instance != $instance))]
    ')
    ;;
  state)
    instance=$3
    state=$4
    case $state in connecting|active|offline|error) ;; *) usage ;; esac
    old_state=$(printf '%s' "$current" | jq -r --arg instance "$instance" '
      first(.contexts[] | select(.instance == $instance) | .state) // ""
    ')
    [ -n "$old_state" ] || exit 0
    [ "$old_state" != "$state" ] || exit 0
    next=$(printf '%s' "$current" | jq -c --arg instance "$instance" --arg state "$state" '
      .revision += 1 |
      .contexts |= map(if .instance == $instance then .state = $state else . end)
    ')
    ;;
  clear)
    has_contexts=$(printf '%s' "$current" | jq '.contexts | length')
    [ "$has_contexts" -gt 0 ] || exit 0
    next=$(printf '%s' "$current" | jq -c '
      .revision += 1 |
      .contexts = []
    ')
    ;;
esac

write_contexts "$next"
