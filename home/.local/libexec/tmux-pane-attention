#!/bin/sh

operation=${1:-}
target=${2:-}
lock_name=tmux-pane-attention-lock
lock_held=0
status_dirty=0
pane_rows=
client_rows=
focused_panes=
dirty_windows=

usage() {
  printf '%s\n' 'usage: tmux-pane-attention reconcile-title PANE | reconcile-window WINDOW | reconcile-all | acknowledge-visible | command-done PANE' >&2
  exit 64
}

case $operation in
  reconcile-title|reconcile-window|command-done) [ -n "$target" ] || usage ;;
  reconcile-all|acknowledge-visible) ;;
  *) usage ;;
esac

release_lock() {
  [ "$lock_held" -eq 1 ] || return 0
  tmux wait-for -U "$lock_name" >/dev/null 2>&1 || :
  lock_held=0
}
trap release_lock 0 1 2 15

tmux wait-for -L "$lock_name" >/dev/null 2>&1 || exit 0
lock_held=1

pane_exists() {
  wanted=$1
  while IFS='|' read -r row_window row_pane row_activity; do
    [ "$row_pane" = "$wanted" ] && return 0
  done <<ROWS
$pane_rows
ROWS
  return 1
}

pane_activity() {
  wanted=$1
  while IFS='|' read -r row_window row_pane row_activity; do
    [ "$row_pane" = "$wanted" ] || continue
    printf '%s\n' "${row_activity:-idle}"
    return
  done <<ROWS
$pane_rows
ROWS
  printf '%s\n' idle
}

current_activity() {
  value=$(tmux show-options -pqv -t "$1" @activity 2>/dev/null || :)
  if [ -n "$value" ]; then
    printf '%s\n' "$value"
  else
    pane_activity "$1"
  fi
}

pane_window() {
  wanted=$1
  while IFS='|' read -r row_window row_pane row_activity; do
    [ "$row_pane" = "$wanted" ] || continue
    printf '%s\n' "$row_window"
    return
  done <<ROWS
$pane_rows
ROWS
}

is_focused() {
  wanted=$1
  while IFS= read -r row_pane; do
    [ "$row_pane" = "$wanted" ] && return 0
  done <<ROWS
$focused_panes
ROWS
  return 1
}

mark_window_dirty() {
  window=$1
  [ -n "$window" ] || return
  case "
$dirty_windows
" in
    *"
$window
"*) ;;
    *) dirty_windows="${dirty_windows}${dirty_windows:+
}$window" ;;
  esac
}

snapshot() {
  pane_rows=$(tmux list-panes -a -F '#{window_id}|#{pane_id}|#{@activity}' 2>/dev/null) || return 1
  client_rows=$(tmux list-clients -F '#{client_name}|#{client_flags}|#{window_id}|#{pane_id}|#{window_zoomed_flag}' 2>/dev/null) || return 1
  focused_panes=
  while IFS='|' read -r client flags window pane zoomed; do
    case ",$flags," in
      *,focused,*)
        pane_exists "$pane" || continue
        focused_panes="${focused_panes}${focused_panes:+
}$pane"
        ;;
    esac
  done <<ROWS
$client_rows
ROWS
}

set_activity() {
  pane=$1
  desired=$2
  current=$(current_activity "$pane")
  [ "$current" != "$desired" ] || return
  if tmux set-option -p -t "$pane" @activity "$desired" >/dev/null 2>&1; then
    status_dirty=1
    mark_window_dirty "$(pane_window "$pane")"
  fi
}

classify_title() {
  title=$1
  lower=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]')
  case $lower in
    *'action required | '*) printf '%s\n' waiting; return ;;
  esac
  case $title in
    ⠋\ *|⠙\ *|⠹\ *|⠸\ *|⠼\ *|⠴\ *|⠦\ *|⠧\ *|⠇\ *|⠏\ *) printf '%s\n' working ;;
    *) printf '%s\n' idle ;;
  esac
}

reconcile_one() {
  pane=$1
  pane_exists "$pane" || return
  tmux set-option -pu -t "$pane" @activity_reconcile_pending >/dev/null 2>&1 || :
  title=$(tmux display-message -p -t "$pane" '#{pane_title}' 2>/dev/null) || return
  title_state=$(classify_title "$title")
  current=$(current_activity "$pane")

  case $title_state in
    working)
      [ "$current" = working ] || set_activity "$pane" working
      ;;
    waiting)
      [ "$current" = waiting ] || set_activity "$pane" waiting
      ;;
    idle)
      case $current in
        working)
          if is_focused "$pane"; then
            set_activity "$pane" idle
          else
            set_activity "$pane" completed
          fi
          ;;
        waiting) set_activity "$pane" idle ;;
      esac
      ;;
  esac
}

acknowledge_focused() {
  scope_window=${1:-}
  while IFS= read -r pane; do
    [ -n "$pane" ] || continue
    if [ -n "$scope_window" ] && [ "$(pane_window "$pane")" != "$scope_window" ]; then
      continue
    fi
    [ "$(pane_activity "$pane")" = completed ] || continue
    set_activity "$pane" idle
  done <<ROWS
$focused_panes
ROWS
}

sync_windows() {
  while IFS= read -r window; do
    [ -n "$window" ] || continue
    desired=idle
    states=$(tmux list-panes -t "$window" -F '#{@activity}' 2>/dev/null || :)
    while IFS= read -r state; do
      case $state in
        waiting) desired=waiting; break ;;
        completed) [ "$desired" = idle ] || [ "$desired" = working ] && desired=completed ;;
        working) [ "$desired" = idle ] && desired=working ;;
      esac
    done <<STATES
$states
STATES
    current=$(tmux show-options -wqv -t "$window" @activity_window 2>/dev/null || :)
    [ "$current" = "$desired" ] && continue
    tmux set-option -w -t "$window" @activity_window "$desired" >/dev/null 2>&1 || :
    status_dirty=1
  done <<WINDOWS
$dirty_windows
WINDOWS
}

refresh_status() {
  [ "$status_dirty" -eq 1 ] || return
  while IFS='|' read -r client flags window pane zoomed; do
    [ -n "$client" ] || continue
    tmux refresh-client -S -t "$client" >/dev/null 2>&1 || :
  done <<ROWS
$client_rows
ROWS
}

snapshot || exit 0

case $operation in
  reconcile-title) reconcile_one "$target" ;;
  reconcile-window)
    mark_window_dirty "$target"
    while IFS='|' read -r window pane activity; do
      [ "$window" = "$target" ] || continue
      reconcile_one "$pane"
    done <<ROWS
$pane_rows
ROWS
    acknowledge_focused "$target"
    ;;
  reconcile-all)
    while IFS='|' read -r window pane activity; do
      [ -n "$pane" ] || continue
      mark_window_dirty "$window"
      reconcile_one "$pane"
    done <<ROWS
$pane_rows
ROWS
    acknowledge_focused
    ;;
  acknowledge-visible) acknowledge_focused ;;
  command-done)
    pane_exists "$target" || exit 0
    if is_focused "$target"; then
      set_activity "$target" idle
    else
      set_activity "$target" completed
    fi
    ;;
esac

sync_windows
release_lock
refresh_status
exit 0
